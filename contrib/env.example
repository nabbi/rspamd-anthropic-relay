# /etc/rspamd-anthropic-relay/env (mode 0600, owned by the relay's user)
# The Anthropic API key, or ANTHROPIC_API_KEY_FILE=/path/to/file
ANTHROPIC_API_KEY=sk-ant-...
# What rspamd sends as its api_key (gpt.conf); any long random string,
# or RELAY_TOKEN_FILE=/path/to/file
RELAY_TOKEN=change-me
#RELAY_LISTEN=127.0.0.1:11338
#RELAY_MODEL=claude-haiku-5-5
#RELAY_MAX_TOKENS=512
#RELAY_THINKING=disabled
#RELAY_EFFORT=low
#RELAY_TIMEOUT=4.5
#RELAY_MAX_CONCURRENT=4
#RELAY_MAX_CONNECTIONS=32
#RELAY_MAX_BODY=524288
#RELAY_MAX_INPUT_CHARS=100000
#RELAY_READ_TIMEOUT=10
#RELAY_IDLE_TIMEOUT=60
# sdk: the Anthropic SDK makes the call (pip install -r requirements-sdk.txt
# first, and raise MemoryMax); docs/backends.md
#RELAY_BACKEND=direct
# off: no <email> tags around the mail and no guard instruction (README.md,
# "Untrusted input")
#RELAY_GUARD=on
#RELAY_SYSLOG_FACILITY=mail
