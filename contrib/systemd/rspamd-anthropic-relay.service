[Unit]
Description=Relay rspamd's gpt module to Anthropic's Messages API
After=network-online.target
Wants=network-online.target
Before=rspamd.service

[Service]
Type=simple
User=rspamd-relay
Environment=RELAY_ENV_FILE=/etc/rspamd-anthropic-relay/env
ExecStart=/opt/rspamd-anthropic-relay/venv/bin/rspamd-anthropic-relay --log syslog
Restart=on-failure
RestartSec=5
# It reads its settings file and talks HTTP; nothing else
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# Sized for RELAY_BACKEND=direct (~25 MiB idle); 200M for sdk (docs/backends.md)
MemoryMax=128M
# One thread per connection: keep RELAY_MAX_CONNECTIONS (32) well under it
TasksMax=64

[Install]
WantedBy=multi-user.target
