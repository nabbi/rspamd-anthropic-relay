[Unit]
Description=Relay rspamd's gpt module to Anthropic's Messages API
After=network-online.target
Wants=network-online.target
Before=rspamd.service

[Service]
Type=simple
User=rspamd-relay
Environment=RELAY_ENV_FILE=/etc/rspamd-anthropic-relay/env
ExecStart=/opt/rspamd-anthropic-relay/venv/bin/rspamd-anthropic-relay --log syslog
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=200M

[Install]
WantedBy=multi-user.target
