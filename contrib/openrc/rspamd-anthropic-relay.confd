# /etc/conf.d/rspamd-anthropic-relay
# The account the relay runs as; it must be able to read RELAY_ENV_FILE
# and the files it names.
#RELAY_USER="rspamd-relay"
# The Python that has the anthropic SDK (a virtualenv, see README.md)
#RELAY_PYTHON="/opt/rspamd-anthropic-relay/venv/bin/python"
# Set when running from a checkout instead of an installed package: the
# checkout's src directory
#RELAY_SRC=""
# KEY=value settings (README.md, "Configuration"), mode 0600
#RELAY_ENV_FILE="/etc/rspamd-anthropic-relay/env"
